# Runtime
SPRING_PROFILES_ACTIVE=h2
XNLP_PORT=8760

# Database: choose mysql, postgres or h2
DB_URL=jdbc:h2:file:./data/xnlp;MODE=MySQL;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=

# Database migrations and HikariCP pool tuning
XNLP_DB_MIGRATION_ENABLED=true
XNLP_DB_MIGRATION_VALIDATE_CHECKSUMS=true
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_VALIDATION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_LEAK_DETECTION_MS=0

# Spring AI: choose ollama or openai
SPRING_AI_MODEL_CHAT=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini

# Authentication: DISABLED, API_KEY, JWT or HYBRID.
# XNLP_SECURITY_ENABLED=true remains a compatibility shortcut for API_KEY.
XNLP_SECURITY_ENABLED=false
XNLP_SECURITY_MODE=
XNLP_SECURITY_HEADER=X-API-Key
XNLP_SECURITY_TENANT_HEADER=X-Tenant-ID
XNLP_SECURITY_DEFAULT_TENANT=default
# Comma-separated keys; set this for API_KEY or HYBRID mode.
XNLP_SECURITY_API_KEYS=
# JWT/HYBRID mode validates issuer, audience, expiry and tenant claim.
XNLP_SECURITY_JWT_ISSUER_URI=
XNLP_SECURITY_JWT_JWK_SET_URI=
XNLP_SECURITY_JWT_AUDIENCE=
XNLP_SECURITY_JWT_TENANT_CLAIM=tenant_id
XNLP_SECURITY_JWT_ROLES_CLAIM=roles
XNLP_SECURITY_JWT_CLOCK_SKEW=60s
XNLP_SECURITY_JWT_DEFAULT_ROLES=VIEWER

# Frontend build-time authentication/tenant headers
VITE_XNLP_API_KEY=
VITE_XNLP_TENANT_ID=default

# Set to openai or ollama to enable semantic similarity and dataset search
SPRING_AI_MODEL_EMBEDDING=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
